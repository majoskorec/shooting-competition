parameters:
    treatPhpDocTypesAsCertain: false
    level: max
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        - '#Property [a-zA-Z0-9\\_]+::\$id \(int\|null\) is never assigned int so it can be removed from the property type.#'
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
