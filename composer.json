{
    "name": "majoskorec/shooting-competition",
    "description": "Shooting competition management system",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.6",
        "easycorp/easyadmin-bundle": "^5.0.8",
        "endroid/qr-code-bundle": "^7.0.1",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.2",
        "symfony/asset": "~8.0.8",
        "symfony/asset-mapper": "~8.0.11",
        "symfony/console": "~8.0.11",
        "symfony/doctrine-messenger": "~8.0.6",
        "symfony/dotenv": "~8.0.11",
        "symfony/expression-language": "~8.0.8",
        "symfony/flex": "^2.10",
        "symfony/form": "~8.0.9",
        "symfony/framework-bundle": "~8.0.11",
        "symfony/http-client": "~8.0.9",
        "symfony/intl": "~8.0.8",
        "symfony/mailer": "~8.0.12",
        "symfony/mime": "~8.0.12",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "~8.0.8",
        "symfony/process": "~8.0.11",
        "symfony/property-access": "~8.0.8",
        "symfony/property-info": "~8.0.8",
        "symfony/runtime": "~8.0.12",
        "symfony/security-bundle": "~8.0.12",
        "symfony/serializer": "~8.0.10",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/string": "~8.0.11",
        "symfony/translation": "~8.0.10",
        "symfony/twig-bundle": "~8.0.8",
        "symfony/ux-icons": "^3.0",
        "symfony/ux-live-component": "^3.0",
        "symfony/ux-turbo": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "~8.0.10",
        "symfony/web-link": "~8.0.8",
        "symfony/yaml": "~8.0.12",
        "twig/extra-bundle": "^3.24",
        "twig/string-extra": "^3.24",
        "twig/twig": "^3.26"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.95.2",
        "friendsoftwig/twigcs": "^6.6.1",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpro/grumphp": "^2.21",
        "phpstan/phpstan": "^2.1.55",
        "phpstan/phpstan-doctrine": "^2.0.22",
        "phpstan/phpstan-symfony": "^2.0.18",
        "phpunit/phpunit": "^13.1.11",
        "pixelfederation/coding-standards": "^5.5.1",
        "psalm/plugin-symfony": "^5.3",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0.1",
        "symfony/browser-kit": "~8.0.8",
        "symfony/css-selector": "~8.0.9",
        "symfony/debug-bundle": "~8.0.8",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "~8.0.8",
        "symfony/web-profiler-bundle": "~8.0.12",
        "vimeo/psalm": "^6.16.1",
        "weirdan/doctrine-psalm-plugin": "^2.10",
        "zenstruck/foundry": "^2.10.1"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "endroid/installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    }
}
