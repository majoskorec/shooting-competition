{# @var competitors_results_with_rank \App\Competition\Results\Model\CompetitorResultWithRank #}
<tr>
    <th
        scope="row"
        class="text-center min-width"
    >
        {{ competitors_results_with_rank.rank|rankIcon }}
    </th>
    <td>
        {{ competitors_results_with_rank.competitorResult.name }}
    </td>
    {% include 'admin/competition/results/_competitor_result_data.html.twig' with {
        competitor_sub_results: competitors_results_with_rank.competitorResult.competitorSubResults[0],
        results: results,
    } %}
    <td class="text-end min-width">
        {{ competitors_results_with_rank.competitorResult.finalResult }}
    </td>
    <td class="min-width text-end">
        {% if competitors_results_with_rank.competitorResult.juryEntryDto is null %}
            <button
                class="btn btn-xs btn-secondary"
                {{ stimulus_action('results-jury-entry-modal', 'open', 'click') }}
                data-url="{{ path(constant('App\\Controller\\Admin\\Competition\\JuryEntryModal\\NewController::ROUTE_NAME'), {
                    categorySlug: results.category.slug,
                    competitorId: competitors_results_with_rank.competitorResult.competitorSubResults[0].competitor.id,
                }) }}"
            >
                {{ ux_icon('bi:plus-square') }}
            </button>
        {% else %}
            <button
                class="btn btn-xs btn-secondary"
                {{ stimulus_action('results-jury-entry-modal', 'open', 'click') }}
                data-url="{{ path(constant('App\\Controller\\Admin\\Competition\\JuryEntryModal\\EditController::ROUTE_NAME'), {
                    juryEntryId: competitors_results_with_rank.competitorResult.juryEntryDto.id,
                }) }}"
            >
                {{ competitors_results_with_rank.competitorResult.juryEntryDto.points }}
                {{ ux_icon('bi:pencil-square') }}
            </button>
        {% endif %}
    </td>
</tr>
