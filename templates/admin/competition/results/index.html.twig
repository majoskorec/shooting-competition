{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    {% include 'admin/competition/_competition_content_title.html.twig' with {
        title: 'Výsledky:',
        competition: results.competition,
    } %}
{% endblock %}

{% block main %}
    <div class="mb-3">
        <a
            href="{{ path(constant('App\\Controller\\Public\\ResultsExportController::ROUTE_NAME'), {
                entityId: results.competition.id,
                categorySlug: results.category.slug,
            }) }}"
            class="btn btn-success"
        >
            Export do XLS
        </a>
    </div>

    {% if resultConstraints|length > 0 %}
        {% for constrain in resultConstraints %}
            <div class="alert alert-{{ constrain.cause|default('danget') }} mb-1 py-1">
                {{ constrain.message|raw }}
            </div>
        {% endfor %}
    {% endif %}

    <ul class="nav nav-pills">
        {% for category in categories.categories %}
            <li class="nav-item">
                <a
                {% if results.category.slug == category.slug %}
                    class="nav-link active"
                    aria-current="page"
                    href="#"
                {% else %}
                    class="nav-link"
                    href="{{ path(constant('App\\Controller\\Admin\\Competition\\ResultsController::ROUTE_NAME'), {
                        entityId: results.competition.id,
                        categorySlug: category.slug,
                    }) }}"
                {% endif %}
                >
                    {{ category.title }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <div
        {{ stimulus_controller('results-jury-entry-modal') }}
    >
        <table class="table text-nowrap table-hover table-striped">
            <thead>
                <tr>
                    {% if results.category.categoryType == enum('App\\Competition\\Results\\Model\\CategoryType').Teams %}
                        {% include 'admin/competition/results/_team_headers.html.twig' %}
                    {% else %}
                        {% include 'admin/competition/results/_individual_headers.html.twig' %}
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for competitors_results_with_rank in results.competitorsResultsWithRank %}
                    {% if results.category.categoryType == enum('App\\Competition\\Results\\Model\\CategoryType').Teams %}
                        {% include 'admin/competition/results/_team_data.html.twig' with {
                            competitors_results_with_rank: competitors_results_with_rank,
                            results: results,
                        } %}
                    {% else %}
                        {% include 'admin/competition/results/_individual_data.html.twig' with {
                            competitors_results_with_rank: competitors_results_with_rank,
                            results: results,
                        } %}
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>

        <div
            class="modal fade"
            tabindex="-1"
            aria-hidden="true"
            {{ stimulus_target('results-jury-entry-modal', 'modal') }}
        ></div>
    </div>
{% endblock %}
