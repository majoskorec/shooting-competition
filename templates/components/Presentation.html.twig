{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div {{ attributes.defaults(stimulus_controller('presentation-form')) }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
            'data-model': 'debounce(100)|*',
        }
    }) }}
    <div class="row" style="min-height: 15rem;">
        <div class="col-6">
            {{ form_row(form.lastName, {
                attr: {
                    ...stimulus_target('presentation-form', 'lastName'),
                },
            }) }}
            {{ form_row(form.firstName, {
                'attr': {
                    ...stimulus_target('presentation-form', 'firstName'),
                },
            }) }}
        </div>
        <div class="col-6">
            {{ form_row(form.shooter, {
                'attr': {
                    ...stimulus_action('presentation-form', 'toggleShooterNameFields', 'change'),
                    ...stimulus_target('presentation-form', 'shooter'),
                },
            }) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.club, {
                'attr': {
                    ...stimulus_target('presentation-form', 'club'),
                }
            }) }}
            {{ form_row(form.email) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.categories) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-xxl-2">
            {{ form_label(form.sharedWeaponCode) }}
            <div class="input-group">
                <button
                    {{ stimulus_action('presentation-form', 'setNewWeapon') }}
                    {{ stimulus_target('presentation-form', 'newWeapon') }}
                    class="btn btn-secondary input-group-button"
                    data-new-weapon-code="{{ this.newWeaponCode }}"
                    type="button"
                >
                    Nová
                </button>
                {{ form_widget(form.sharedWeaponCode, {
                    'attr': {
                        ...stimulus_action('presentation-form', 'syncSharedWeaponCode', 'keyup'),
                        ...stimulus_target('presentation-form', 'sharedWeaponCode'),
                    }
                }) }}
            </div>
            {{ form_errors(form.sharedWeaponCode) }}


        </div>
        <div class="col-md-9 col-xxl-10">
            <div class="form-label">
                Zdieľané zbrane
                <input
                    type="text"
                    data-live-ignore
                    class="bg-primary border-0 rounded-2 text-white px-2"
                    style="width: 2rem;"
                    {{ stimulus_action('presentation-form', 'filterSharedWeapons', 'keyup') }}
                    {{ stimulus_target('presentation-form', 'sharedWeaponsCode') }}
                />
                <button
                    type="button"
                    class="btn btn-sm btn-warning px-1"
                    {{ stimulus_target('presentation-form', 'sharedWeaponsToggle') }}
                    {{ stimulus_action('presentation-form', 'toggleSharedWeapons') }}
                >
                    Zobraziť všetky
                </button>
            </div>
            <div
                class="d-flex justify-content-start flex-wrap gap-1"
                style="max-height: 2rem; overflow: hidden;"
                {{ stimulus_target('presentation-form', 'sharedWeaponsList') }}
            >
            {% for code,competitors in this.sharedWeapons %}
                <div
                    class="p-1 border border rounded-2 bg-secondary-subtle cursor-pointer"
                    {{ stimulus_action('presentation-form', 'selectSharedWeapon', 'click') }}
                    {{ stimulus_target('presentation-form', 'sharedWeapons') }}
                    data-shared-weapon-code="{{ code }}"
                >
                    <span class="badge text-bg-primary px-2">
                        {{ code }}
                    </span>
                    {% for competitor in competitors %}
                        <span class="badge text-bg-secondary ms-1">
                            {{ competitor.shooter.fullName }}
                        </span>
                    {% endfor %}
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
    <hr />

    {% if this.competition.teamMemberCount > 1 %}
        <div class="row" style="min-height: 13rem;">
            <div class="col-6">
                <div class="mb-3">
                    {{ form_label(form.teamName) }}
                    <div class="input-group">
                        <button
                            {{ stimulus_action('presentation-form', 'setTeamFromClub') }}
                            {{ stimulus_target('presentation-form', 'useClubButton') }}
                            class="btn btn-secondary input-group-button"
                            type="button"
                        >
                            Použi Klub / PZ
                            {{ ux_icon('bi:chevron-right') }}
                        </button>
                        {{ form_widget(form.teamName, {
                            'attr': {
                                ...stimulus_target('presentation-form', 'teamName'),
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.teamName) }}
                </div>
            </div>
            <div class="col-6">
                {{ form_row(form.competitionTeam, {
                    'attr': {
                        ...stimulus_action('presentation-form', 'toggleTeamNameFields', 'change'),
                        ...stimulus_target('presentation-form', 'competitionTeam'),
                    },
                }) }}
            </div>
        </div>
    {% else %}
        <div class="row">
            <div class="col-12 text-center">
                Bez Družstiev
            </div>
        </div>
    {% endif %}

    {{ form_errors(form) }}

    <div class="row mt-1">
        <div class="col">
            <button class="btn btn-primary px-5">
                Ulož
            </button>
        </div>
    </div>

    {{ form_end(form) }}
</div>
